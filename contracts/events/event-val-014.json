{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebmr.internal/contracts/events/event-val-014.json",
  "title": "SPEC-VAL-014 — Security Qualification, Vulnerability Verification & Pen Testing Events",
  "description": "Document 113 event contract for the events app/modules/validation/commands_security.py actually emits. All 4 of the catalogue's declared Document 92 events are implemented: SecurityControlTestCompleted, PenTestFindingImported, SecurityQualificationGateEvaluated, SecurityQualificationApproved. (The module also emits an undeclared SecuritySuiteDefined at suite-authoring time -- not part of the catalogue's declared 4.) Verified directly against source, including indirection through the shared finalize() helper and, where present, dict-keyed event-type lookups and parameterized shared helpers -- not a literal-string grep alone.",
  "x-requirement-ids": [
    "SECQ-FR-001",
    "SECQ-FR-002",
    "SECQ-FR-003",
    "SECQ-FR-004",
    "SECQ-FR-005",
    "SECQ-FR-006",
    "SECQ-FR-007",
    "SECQ-FR-008"
  ],
