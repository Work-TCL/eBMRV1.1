      "required": [
        "control_ref",
        "result"
      ],
      "properties": {
        "control_ref": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
