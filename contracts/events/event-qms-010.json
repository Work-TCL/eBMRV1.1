      "schema_version": "1.0",
      "producer": "SPEC-QMS-010",
      "aggregate_type": "complaint_record",
      "payload": {
        "$ref": "#/$defs/ComplaintInvestigationRequiredPayload"
      },
      "x-requirement-ids": [
        "CMP-FR-007",
        "CMP-FR-009"
      ]
    },
    {
      "event_type": "ComplaintInvestigationWaivedWithRationale",
      "schema_version": "1.0",
      "producer": "SPEC-QMS-010",
      "aggregate_type": "complaint_record",
      "payload": {
        "$ref": "#/$defs/ComplaintInvestigationWaivedWithRationalePayload"
      },
      "x-requirement-ids": [
        "CMP-FR-007",
        "CMP-FR-008"
      ]
    },
    {
      "event_type": "ComplaintReportabilityAssessmentCompleted",
      "schema_version": "1.0",
      "producer": "SPEC-QMS-010",
      "aggregate_type": "complaint_record",
      "payload": {
        "$ref": "#/$defs/ComplaintReportabilityAssessmentCompletedPayload"
      },
      "x-requirement-ids": [
        "CMP-FR-012"
      ]
    },
    {
      "event_type": "ComplaintCAPAOpened",
      "schema_version": "1.0",
      "producer": "SPEC-QMS-010",
      "aggregate_type": "complaint_record",
      "payload": {
        "$ref": "#/$defs/ComplaintCAPAOpenedPayload"
      },
      "x-requirement-ids": [
        "CMP-FR-017"
      ]
    },
    {
      "event_type": "ComplaintFieldActionAssessmentOpened",
      "schema_version": "1.0",
      "producer": "SPEC-QMS-010",
      "aggregate_type": "complaint_record",
      "payload": {
        "$ref": "#/$defs/ComplaintFieldActionAssessmentOpenedPayload"
      },
      "x-requirement-ids": [
        "CMP-FR-018"
      ]
    },
    {
      "event_type": "ComplaintClosed",
      "schema_version": "1.0",
      "producer": "SPEC-QMS-010",
      "aggregate_type": "complaint_record",
      "payload": {
        "$ref": "#/$defs/ComplaintClosedPayload"
      },
      "x-requirement-ids": [
        "CMP-FR-020"
      ]
    }
  ]
}
