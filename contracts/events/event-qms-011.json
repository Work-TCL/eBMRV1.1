      "producer": "SPEC-QMS-011",
      "aggregate_type": "field_action",
      "payload": {
        "$ref": "#/$defs/FieldActionApprovedPayload"
      },
      "x-requirement-ids": [
        "FAR-FR-009"
      ]
    },
    {
      "event_type": "FieldActionNotificationSent",
      "schema_version": "1.0",
      "producer": "SPEC-QMS-011",
      "aggregate_type": "field_action",
      "payload": {
        "$ref": "#/$defs/FieldActionNotificationSentPayload"
      },
      "x-requirement-ids": [
