      ],
      "properties": {
        "approved": {
          "type": "boolean"
        }
      },
      "x-requirement-ids": [
        "IQ-FR-001",
        "IQ-FR-002",
        "IQ-FR-003",
        "IQ-FR-004",
        "IQ-FR-005",
        "IQ-FR-006",
        "IQ-FR-007",
        "IQ-FR-008"
      ],
      "additionalProperties": false
    }
  },
  "events": [
    {
      "event_type": "InstalledInventoryCaptured",
      "schema_version": "1.0",
      "producer": "SPEC-VAL-005",
      "aggregate_type": "iq_execution",
      "payload": {
        "$ref": "#/$defs/InstalledInventoryCapturedPayload"
