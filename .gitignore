# --- Python virtualenvs ---
/env/
services/gxp-api/.venv/
services/*/.venv/


# --- Node ---
frontend/node_modules/
**/node_modules/

# --- Build/cache artefacts ---
frontend/.next/
frontend/tsconfig.tsbuildinfo
frontend/next-env.d.ts
**/__pycache__/
**/.pytest_cache/
sites/assets/

# --- Logs ---
/logs/
frontend/logs/
services/*/logs/
eBMR-ui/.serve.log
sites/*/logs/

# --- Secrets: real DB credentials / JWT signing keys, never commit ---
services/gxp-api/.env
sites/*/site_config.json

# --- Bench runtime state ---
config/pids/
config/*.pid

# --- OS ---
.DS_Store

# --- Claude Code local runtime state ---
/.claude/
config.bat

# --- WP-11 local infra runtime data (rebuildable, never authoritative -- AG-09) ---
infra/nats-data/
